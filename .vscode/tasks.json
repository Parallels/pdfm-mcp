{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "make build-debug",
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "build",
      "type": "shell",
      "command": "make build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "check",
      "type": "shell",
      "command": "make check",
      "problemMatcher": ["$go"]
    },
    {
      "label": "inspect",
      "type": "shell",
      "command": "make inspect",
      "isBackground": true,
      "problemMatcher": {
        "owner": "inspector",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting MCP inspector",
          "endsPattern": "MCP Inspector is up|localhost:6274"
        }
      }
    }
  ]
}
